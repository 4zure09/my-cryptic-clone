# Choose one provider. The initial plan assumes OpenAI.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional: reuse an existing store. When blank, the first upload creates one and
# records its ID in STATE_FILE for later daily runs.
OPENAI_VECTOR_STORE_ID=
# Optional legacy Playground Assistant ID (must start with asst_, not agent_).
ASSISTANT_ID=
OPENAI_VECTOR_STORE_NAME=opb-store
OPENAI_MODEL=gpt-5-mini
UPLOAD_ENABLED=false
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Source and local persistence
SOURCE_BASE_URL=https://support.optisigns.com
# Keep the submitted corpus intentionally small while satisfying the >30 requirement.
ARTICLE_LIMIT=40
SOURCE_LOCALE=en-us
DATA_DIR=data/articles
STATE_FILE=state/articles.json
LOG_LEVEL=INFO
